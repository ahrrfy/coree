{
  "_about": "Rebrand sweep configuration for coree. Used with replica-brand/sweep.py to ensure zero leftover Corel brand names, domains, or signature green hex colors leak into coree's shipped source code or assets.",
  "brand": "coree",
  "avoid": [
    "CorelDRAW",
    "Corel DRAW",
    "Corel Corporation",
    "Alludo",
    "PHOTO-PAINT",
    "PowerTRACE",
    "Corel Font Manager",
    "Corel CAPTURE",
    "Corel Cloud",
    "CorelDRAW.app",
    "Corel"
  ],
  "domains": [
    "corel.com",
    "coreldraw.com",
    "alludo.com",
    "corel.net",
    "product.corel.com",
    "learn.corel.com",
    "community.coreldraw.com"
  ],
  "colors": [
    "#009c4a",
    "#00a651",
    "#00843d",
    "#1b8e3e",
    "#4eb848",
    "#009944"
  ],
  "mime_allowlist": {
    "literals": [
      "application/x-vnd.corel.zcf.draw.document+zip",
      "application/x-vnd.corel.zcf.draw.template+zip",
      "application/x-vnd.corel.draw.document+zip",
      "application/x-vnd.corel.draw.template+zip",
      "application/x-vnd.corel.zcf.draw.template",
      "application/x-vnd.corel.draw.template",
      "application/x-vnd.corel",
      "application/vnd.corel-draw",
      "application-vnd.corel-draw"
    ],
    "allowed_files": [
      "crates/coree-cdr/src/cdr_zip.rs",
      "crates/coree-cdr/tests/codec_integration.rs",
      "packaging/linux/coree-mime.xml",
      "packaging/linux/coree.desktop",
      "packaging/linux/coree.thumbnailer",
      "packaging/linux/flatpak/io.github.ahrrfy.coree.metainfo.xml",
      "packaging/linux/build-appimage.sh",
      "packaging/linux/build-deb.sh",
      "packaging/linux/install-linux.sh",
      "packaging/windows/wix/main.wxs"
    ]
  }
}
