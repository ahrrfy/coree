/* Win32 Resource Script for coree.exe (compatible with MSVC rc.exe and MinGW windres). */

#pragma code_page(65001)

1 ICON "coree.ico"
1 24 "coree.exe.manifest"

1 VERSIONINFO
FILEVERSION     0,3,1,0
PRODUCTVERSION  0,3,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "coree contributors\0"
            VALUE "FileDescription",  "coree Vector Graphics, Laser & Print Production Studio\0"
            VALUE "FileVersion",      "0.3.1.0\0"
            VALUE "InternalName",     "coree\0"
            VALUE "LegalCopyright",   "coree contributors (MIT OR Apache-2.0)\0"
            VALUE "OriginalFilename", "coree.exe\0"
            VALUE "ProductName",      "coree\0"
            VALUE "ProductVersion",   "0.3.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
